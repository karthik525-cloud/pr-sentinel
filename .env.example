# Optional: token with read access. Never commit real credentials.
GITHUB_TOKEN=
# Range: 1..3000 (GitHub returns at most 3000 files).
MAX_CHANGED_FILES=500
# Total UTF-8 bytes across available patches.
MAX_DIFF_BYTES=1000000
# Maximum decoded JSON bytes per GitHub response.
MAX_UPSTREAM_BYTES=8000000

# AI is opt-in. Keep these blank/false until you choose a free-tier model and
# create a Gemini Developer API key in a project WITHOUT billing enabled.
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_FREE_TIER_CONFIRMED=false
# Documentation checked 2026-10-27: gemini-3.8-flash supports free standard-tier
# text, function calling, and structured output. Recheck before selecting it.
# Optional manual fallback: gemini-3.5-flash-lite (also documented free-tier).
# Prefer a per-command GEMINI_MODEL override to preserve your primary setting.
# No runtime default model or automatic model fallback is used.
AI_MAX_TOOL_CALLS=3
AI_MAX_LLM_REQUESTS=4
AI_MAX_CONTEXT_CHARS=20000
AI_MAX_TOOL_LINES=200
AI_MAX_CANDIDATES=10
# Optional: low, medium, high. Blank inherits the model default:
# medium for Gemini 3.8 Flash, minimal for Gemini 3.5 Flash-Lite.
# Explicit minimal is not exposed because the primary 3.8 model rejects it.
# A blank per-command override is suitable for the fallback's simple OK probe.
AI_THINKING_LEVEL=
AI_MAX_OUTPUT_TOKENS=4096
AI_MODEL_TIMEOUT_SECONDS=30
AI_REVIEW_DEADLINE_SECONDS=120
AI_MAX_FILE_BYTES=262144
AI_MAX_TOOL_CONTEXT_CHARS=10000
AI_MAX_RESPONSE_CHARS=32000
AI_MAX_REQUEST_CHARS=160000
